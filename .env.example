# 🚢 DOCKLY - Configuração de Ambiente
# Copie este arquivo para .env e configure com seus valores

# ================================
# 🗄️ BANCO DE DADOS (OBRIGATÓRIO)
# ================================

# URL de conexão MySQL
# Formato: mysql://usuario:senha@host:porta/banco
# Exemplo: mysql://root:senha123@localhost:3306/cruise_mapper
DATABASE_URL=mysql://usuario:senha@localhost:3306/cruise_mapper

# ================================
# 🔐 AUTENTICAÇÃO (OBRIGATÓRIO)
# ================================

# Secret para JWT (gere uma string aleatória forte)
# Você pode usar: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-super-segura-aqui

# OpenID do administrador principal
# Este usuário terá privilégios de admin automaticamente
OWNER_OPEN_ID=seu-openid-aqui

# ================================
# 🌐 SERVIDOR
# ================================

# Porta do servidor (padrão: 5000)
PORT=5000

# Ambiente (development | production)
NODE_ENV=development

# URL base da aplicação
BASE_URL=http://localhost:5000

# ================================
# 🗺️ GOOGLE MAPS (OPCIONAL)
# ================================

# API Key do Google Maps para visualização de mapas
# Obtenha em: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=sua-api-key-aqui

# ================================
# 📧 EMAIL (OPCIONAL)
# ================================

# Configuração SMTP para envio de emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app

# Email remetente
FROM_EMAIL=noreply@dockly.com
FROM_NAME=Dockly Cruise Mapper

# ================================
# 🤖 SCRAPING (OPCIONAL)
# ================================

# Delay entre requests (ms)
SCRAPER_DELAY=2000

# User Agent para scraping
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Timeout para requests (ms)
SCRAPER_TIMEOUT=30000

# Máximo de tentativas em caso de falha
SCRAPER_MAX_RETRIES=3

# ================================
# 💾 CACHE (OPCIONAL)
# ================================

# Habilitar cache
CACHE_ENABLED=true

# Tempo de vida do cache (segundos)
CACHE_TTL=3600

# ================================
# 📊 LOGS (OPCIONAL)
# ================================

# Nível de log (error | warn | info | verbose | debug)
LOG_LEVEL=info

# Habilitar logs detalhados
DEBUG=false

# Salvar logs em arquivo
LOG_TO_FILE=true

# Caminho do arquivo de log
LOG_FILE_PATH=./logs/app.log

# ================================
# 🔒 SEGURANÇA
# ================================

# Habilitar CORS
CORS_ENABLED=true

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# 🎨 RECURSOS EXTERNOS
# ================================

# CDN para imagens (opcional)
CDN_URL=https://cdn.seudominio.com

# AWS S3 para armazenamento (opcional)
AWS_ACCESS_KEY_ID=sua-access-key
AWS_SECRET_ACCESS_KEY=sua-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=dockly-assets

# ================================
# 📱 NOTIFICAÇÕES (OPCIONAL)
# ================================

# Webhook para notificações
WEBHOOK_URL=https://hooks.slack.com/services/...

# ================================
# 🔄 AGENDAMENTO
# ================================

# Habilitar jobs agendados
SCHEDULER_ENABLED=true

# Fuso horário para agendamentos
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Frequência de atualização de itinerários (cron format)
# Exemplo: "0 0 * * *" = Diariamente à meia-noite
UPDATE_ITINERARIES_CRON=0 0 * * *

# ================================
# 🧪 DESENVOLVIMENTO
# ================================

# Habilitar hot reload
HOT_RELOAD=true

# Seed database on start
SEED_ON_START=false

# ================================
# 📈 ANALYTICS (OPCIONAL)
# ================================

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry para error tracking
SENTRY_DSN=https://xxxx@sentry.io/xxxxx

# ================================
# NOTAS IMPORTANTES
# ================================

# 1. NUNCA commite este arquivo com valores reais no Git
# 2. Mantenha suas credenciais seguras
# 3. Use valores diferentes em produção
# 4. Variáveis marcadas como OBRIGATÓRIO são essenciais
# 5. Variáveis OPCIONAIS podem ser comentadas se não usadas

# ================================
# VALORES DE EXEMPLO PARA DEV
# ================================

# Para desenvolvimento local, você pode usar:
# DATABASE_URL=mysql://root:root@localhost:3306/dockly_dev
# JWT_SECRET=dev-secret-change-in-production
# OWNER_OPEN_ID=dev-admin-123
# NODE_ENV=development
# PORT=5000

# ================================
# CHECKLIST DE SETUP
# ================================

# [ ] Criar banco de dados MySQL
# [ ] Configurar DATABASE_URL
# [ ] Gerar JWT_SECRET forte
# [ ] Definir OWNER_OPEN_ID
# [ ] Configurar outras variáveis conforme necessário
# [ ] Executar: npm run db:push
# [ ] Executar: npm run setup:all
# [ ] Iniciar: npm run dev

# ================================
# SUPORTE
# ================================

# Para mais informações, consulte:
# - README.md
# - TROUBLESHOOTING.md
# - Documentação do projeto
